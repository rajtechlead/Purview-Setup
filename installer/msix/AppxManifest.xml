<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">

  <Identity Name="BelleRajaCorp.PurviewGovernanceCopilot"
            Publisher="CN=Belle-RajaCorp"
            Version="1.0.0.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Purview Governance Copilot</DisplayName>
    <PublisherDisplayName>Belle-RajaCorp</PublisherDisplayName>
    <Description>Assess, plan, govern and monitor Microsoft Purview with local AI privacy guardrails.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="PurviewGovernanceCopilot.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Purview Governance Copilot"
                          Description="Purview assessment, governance and AI privacy workspace"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png"
                          BackgroundColor="#0B1220" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
