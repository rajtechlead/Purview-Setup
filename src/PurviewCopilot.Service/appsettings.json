{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Collaboration": {
    "Provider": "Sqlite",
    "DataDirectory": "",
    "MaxPayloadBytes": 1048576,
    "MaxOperations": 500,
    "MaxPageSize": 200,
    "Approval": {
      "Security": 1,
      "Compliance": 1,
      "Cab": 1
    }
  },
  "ConnectionStrings": {
    "Collaboration": ""
  },
  "AzureAd": {
    "Authority": "",
    "Audience": ""
  },
  "Service": {
    "RequireHttps": true,
    "BootstrapTenant": "",
    "BootstrapAdmin": ""
  }
}
