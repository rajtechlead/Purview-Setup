<UserControl x:Class="PurviewCopilot.UI.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Topics" Style="{StaticResource SectionHeader}" />
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"
                         ToolTip="Search the help center" />
                <ListBox ItemsSource="{Binding Filtered}" SelectedItem="{Binding Selected}" Height="520">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Category}" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding Selected.Category}" Style="{StaticResource Muted}" />
                <TextBlock Text="{Binding Selected.Title}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,12" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Selected.Body}" FontSize="13" TextWrapping="Wrap" LineHeight="21"
                           Foreground="{StaticResource MutedBrush}" />
                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,18,0,0">
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Tip: every recommendation generated by this tool maps to one of these topics. Use the control ID from a finding to search the relevant technology in the Help Center." />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
