<UserControl x:Class="PurviewCopilot.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <DataTemplate x:Key="ModuleListTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="54" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Module}" FontSize="12" TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1" VerticalAlignment="Center" Value="{Binding Score}" Maximum="100" />
                <TextBlock Grid.Column="2" Text="{Binding Score, StringFormat={}{0:0.#}}"
                           HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource MutedBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TrendTemplate">
            <StackPanel Margin="0,0,10,0" Width="42" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding Value}" FontSize="10" HorizontalAlignment="Center" />
                <Rectangle Height="{Binding Height}" Width="26" RadiusX="3" RadiusY="3"
                           Fill="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Label}" FontSize="9" HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="HeatmapTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="10" Opacity="{Binding Opacity}"
                    BorderBrush="{Binding Severity, Converter={StaticResource SeverityBrush}}" BorderThickness="1">
                <StackPanel Width="128">
                    <TextBlock Text="{Binding Count}" FontSize="20" FontWeight="Bold"
                               Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                    <TextBlock Text="{Binding Module}" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Severity}" Style="{StaticResource Muted}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FrameworkTemplate">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Framework}" FontSize="12" />
                <ProgressBar Grid.Column="1" VerticalAlignment="Center" Value="{Binding Percent}" Maximum="100" />
                <TextBlock Grid.Column="2" Text="{Binding Percent, StringFormat={}{0:0.#}%}"
                           HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource MutedBrush}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel>
                <TextBlock Text="No assessment in this session" Style="{StaticResource SectionHeader}" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="Open Assessment and run discovery against your tenant, or load the sample tenant to explore the workspace. Assessments are read-only." />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding TenantName}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Collected}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding MaturityTrail}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,26,0">
                        <TextBlock Text="Maturity band" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Band}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,26,0">
                        <TextBlock Text="Failures" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding FailCount}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BadBrush}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,26,0">
                        <TextBlock Text="Warnings" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding WarningCount}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Recommendations" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding RecommendationCount}" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding Scores}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Display}" Style="{StaticResource KpiValue}"
                                       Foreground="{Binding Value, Converter={StaticResource ScoreBrush}}" />
                            <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding WarningText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12" />

        <TabControl Margin="0,4,0,0">
            <TabItem Header="Executive">
                <StackPanel Margin="0,10,0,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Score trend" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="{Binding OverallDelta}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Trend}" Height="120" ItemTemplate="{StaticResource TrendTemplate}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="Overall score for the most recent assessments, oldest to newest."
                                       Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Module coverage" Style="{StaticResource SectionHeader}" />
                                <ItemsControl ItemsSource="{Binding Modules}" ItemTemplate="{StaticResource ModuleListTemplate}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Priority findings" Style="{StaticResource SectionHeader}" />
                                <ItemsControl ItemsSource="{Binding PrioritisedFindings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,2,8,2"
                                                            Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap" />
                                                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0">
                                                            <Run Text="{Binding Id}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding Status}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding Severity}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Security">
                <StackPanel Margin="0,10,0,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Security posture" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{Binding SecuritySummary}" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Risk heatmap — open findings by module and severity" Style="{StaticResource SectionHeader}" />
                            <ItemsControl ItemsSource="{Binding Heatmap}" ItemTemplate="{StaticResource HeatmapTemplate}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="Cell intensity reflects the number of open findings; colour reflects severity."
                                       Style="{StaticResource Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Security modules" Style="{StaticResource SectionHeader}" />
                            <ItemsControl ItemsSource="{Binding SecurityModules}" ItemTemplate="{StaticResource ModuleListTemplate}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="Governance">
                <StackPanel Margin="0,10,0,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Governance posture" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{Binding GovernanceSummary}" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding MaturityTrail}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Lifecycle, records and AI governance modules" Style="{StaticResource SectionHeader}" />
                            <ItemsControl ItemsSource="{Binding GovernanceModules}" ItemTemplate="{StaticResource ModuleListTemplate}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="Compliance">
                <StackPanel Margin="0,10,0,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Compliance posture" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{Binding ComplianceSummary}" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Framework readiness" Style="{StaticResource SectionHeader}" />
                                <ItemsControl ItemsSource="{Binding Frameworks}" ItemTemplate="{StaticResource FrameworkTemplate}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Compliance modules" Style="{StaticResource SectionHeader}" />
                                <ItemsControl ItemsSource="{Binding ComplianceModules}" ItemTemplate="{StaticResource ModuleListTemplate}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Portfolio">
                <StackPanel Margin="0,10,0,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Cross-tenant portfolio" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{Binding PortfolioHint}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Export portfolio (CSV)" Command="{Binding ExportPortfolioCommand}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding PortfolioExportStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Customer" Style="{StaticResource Muted}" />
                                <TextBlock Grid.Column="1" Text="Overall" Style="{StaticResource Muted}" />
                                <TextBlock Grid.Column="2" Text="Security" Style="{StaticResource Muted}" />
                                <TextBlock Grid.Column="3" Text="Compliance" Style="{StaticResource Muted}" />
                                <TextBlock Grid.Column="4" Text="Risk" Style="{StaticResource Muted}" />
                                <TextBlock Grid.Column="5" Text="Maturity" Style="{StaticResource Muted}" />
                                <TextBlock Grid.Column="6" Text="Last assessed" Style="{StaticResource Muted}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Portfolio}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding TenantId}" Style="{StaticResource Muted}" FontSize="10" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding OverallText}" FontSize="12" />
                                                <TextBlock Grid.Column="2" Text="{Binding SecurityText}" FontSize="12" />
                                                <TextBlock Grid.Column="3" Text="{Binding ComplianceText}" FontSize="12" />
                                                <TextBlock Grid.Column="4" Text="{Binding RiskText}" FontSize="12" />
                                                <TextBlock Grid.Column="5" Text="{Binding MaturityText}" FontSize="12" />
                                                <TextBlock Grid.Column="6" Text="{Binding AssessedText}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
