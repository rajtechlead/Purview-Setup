<UserControl x:Class="PurviewCopilot.UI.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding Product}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Version, StringFormat=Version {0}}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Platform}" Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="52" Height="52" CornerRadius="12"
                        Background="{StaticResource AccentDeepBrush}">
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="22"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Designed and built by" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding DesignedBy}" FontSize="18" />
                    <TextBlock Text="{Binding Owner, StringFormat=Owned by {0}}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Contact}" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Operating principles" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding SupportNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding BuildInfo}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Supported platforms" Style="{StaticResource SectionHeader}" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="Windows 10 and Windows 11 (supported servicing branches), Windows Server 2019, Windows Server 2022 and Windows Server 2025. End-of-life operating systems are not supported." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
