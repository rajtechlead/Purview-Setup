<UserControl x:Class="PurviewCopilot.UI.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="Refresh signals" Command="{Binding RefreshCommand}" Margin="0,0,12,0" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Continuous monitoring" Style="{StaticResource SectionHeader}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Check every (minutes, 0 = off)" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="60" Text="{Binding IntervalMinutes}" Margin="0,0,10,0" />
                    <Button Content="Save schedule" Command="{Binding SaveScheduleCommand}" Margin="0,0,8,0" />
                    <Button Content="Check now" Command="{Binding CheckNowCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding ScheduleText}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                <TextBlock Text="Alert webhook (https)" Style="{StaticResource Muted}" Margin="0,8,0,2" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBox Width="360" Text="{Binding AlertWebhookUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                             ToolTip="https://hooks.example.com/purview-alerts" />
                    <Button Content="Send alerts now" Command="{Binding SendAlertsCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding AlertDeliveryStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Checks reuse the configured certificate and are read-only. The schedule runs while this window is open; use Windows Task Scheduler for unattended runs." />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Alerts" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Alerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,2,8,2"
                                            Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0">
                                            <Run Text="{Binding Severity}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding AtUtc, StringFormat=yyyy-MM-dd HH:mm}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Alerts are generated locally from drift, score movement and critical failures. No external notification channel is configured."
                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="AI usage ledger" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="{Binding AiUsageText}" FontSize="13" />
                <TextBlock Text="{Binding AiCostText}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Drift since previous collection" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Drift}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="{Binding Severity}" FontSize="11" Margin="10,0,0,0"
                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
                                        <Run Text="Baseline:" />
                                        <Run Text="{Binding BaselineValue}" />
                                        <Run Text=" → Current:" />
                                        <Run Text="{Binding CurrentValue}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding RecommendedAction}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Licence utilisation" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding Licenses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PartNumber}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Grid.Column="1" Value="{Binding Utilization}" Maximum="100" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding UtilizationText}" FontSize="12"
                                               HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Optimisation insights" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding LicenseInsights}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Recommendation}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
