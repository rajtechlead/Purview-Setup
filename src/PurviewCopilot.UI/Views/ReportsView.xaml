<UserControl x:Class="PurviewCopilot.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Organisation" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="260" Text="{Binding Organization}" Margin="0,0,16,0" />
                    <Button Content="Export HTML" Command="{Binding ExportHtmlCommand}" Margin="0,0,8,0" />
                    <Button Content="Export PDF" Command="{Binding ExportPdfCommand}" Margin="0,0,8,0" />
                    <Button Content="Export DOCX" Command="{Binding ExportDocxCommand}" Margin="0,0,8,0" />
                    <Button Content="Export XLSX" Command="{Binding ExportXlsxCommand}" Margin="0,0,8,0" />
                    <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" Margin="0,0,8,0" />
                    <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0" />
                    <Button Content="Export Markdown" Command="{Binding ExportMarkdownCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Executive framework readiness" Style="{StaticResource SectionHeader}" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Coverage is the share of assessed controls mapped to each framework that pass. Gaps list failing controls so the report stays actionable." />
                <ItemsControl ItemsSource="{Binding Frameworks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="82" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Framework}" FontSize="13" FontWeight="SemiBold" />
                                        <ProgressBar Grid.Column="1" Value="{Binding Percent}" Maximum="100" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontSize="13"
                                                   Text="{Binding Percent, StringFormat={}{0:0.#}%}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap">
                                        <Run Text="{Binding CoveredControls}" />
                                        <Run Text=" of " />
                                        <Run Text="{Binding TotalControls}" />
                                        <Run Text=" controls covered" />
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Gaps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
