<UserControl x:Class="PurviewCopilot.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Connection" Style="{StaticResource SectionHeader}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Auth mode" Style="{StaticResource Muted}" Margin="0,8" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AuthModes}" SelectedItem="{Binding AuthMode}" Margin="0,4,16,4" />

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Tenant ID" Style="{StaticResource Muted}" Margin="0,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding TenantId}" Margin="0,4" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Application (client) ID" Style="{StaticResource Muted}" Margin="0,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ClientId}" Margin="0,4,16,4" />

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Certificate thumbprint" Style="{StaticResource Muted}" Margin="0,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Thumbprint}" Margin="0,4" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Client secret (lab only)" Style="{StaticResource Muted}" Margin="0,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4,16,4" Text="{Binding ClientSecret}"
                             ToolTip="Protected at rest with Windows DPAPI for the current user. Use certificate authentication for production." />

                    <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4">
                        <Button Content="Test connection" Command="{Binding TestConnectionCommand}" Margin="0,0,8,0" />
                        <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Verify audit log integrity" Command="{Binding VerifyAuditCommand}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding AuditStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="720" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,14">
                <StackPanel>
                    <TextBlock Text="Certificate lifecycle" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding CertificateWarning}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Subject" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="240" Text="{Binding CertificateSubject}" Margin="0,0,8,0" />
                        <TextBlock Text="Months" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="46" Text="{Binding CertificateMonths}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Create" Command="{Binding CreateCertificateCommand}" Margin="0,0,6,0" />
                        <Button Content="Import PFX" Command="{Binding ImportCertificateCommand}" Margin="0,0,6,0" />
                        <Button Content="Export PFX" Command="{Binding ExportCertificateCommand}" Margin="0,0,6,0" />
                        <Button Content="Rotate" Command="{Binding RotateCertificateCommand}" Margin="0,0,6,0" />
                        <Button Content="Remove" Command="{Binding RemoveCertificateCommand}" />
                    </StackPanel>

                    <TextBox Text="{Binding PfxPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                             ToolTip="Optional PFX password used for import and export" />

                    <ItemsControl ItemsSource="{Binding Certificates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Subject}" FontSize="12" />
                                        <TextBlock Style="{StaticResource Muted}">
                                            <Run Text="{Binding Thumbprint}" />
                                            <Run Text=" · expires " />
                                            <Run Text="{Binding NotAfter, StringFormat=yyyy-MM-dd}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding StorageLocation}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="AI privacy guardrail" Style="{StaticResource SectionHeader}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Mode" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Width="180" ItemsSource="{Binding RedactionModes}" SelectedItem="{Binding RedactionMode}" />
                        </StackPanel>
                        <CheckBox Content="Allow cloud AI providers" IsChecked="{Binding CloudAiEnabled}" />
                        <CheckBox Content="Offline mode (local providers only)" IsChecked="{Binding OfflineMode}" />
                        <CheckBox Content="Require administrator review before send" IsChecked="{Binding RequirePromptReview}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="AI providers" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Keys are read from environment variables named in each provider's key reference; they are never stored in the database." />
                        <ItemsControl ItemsSource="{Binding Providers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding Enabled}" Content="{Binding DisplayName}" />
                                            <TextBlock Style="{StaticResource Muted}">
                                                <Run Text="{Binding Kind}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Model}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Endpoint}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Customer tenants (MSP mode)" Style="{StaticResource SectionHeader}" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Save the current connection as a customer tenant, then activate a tenant to point the next assessment at it. Credentials and evidence stay scoped to that tenant; switching clears the in-session assessment." />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Display name" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="240" Text="{Binding TenantDisplayName}" Margin="0,0,10,0" />
                    <Button Content="Save current connection" Command="{Binding SaveTenantCommand}" Margin="0,0,8,0" />
                    <Button Content="Activate selected" Style="{StaticResource PrimaryButton}" Command="{Binding ActivateTenantCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding TenantProfiles}" SelectedItem="{Binding SelectedTenant}" MaxHeight="180"
                         Background="{StaticResource SurfaceAltBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Muted}">
                                    <Run Text="{Binding TenantId}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding Auth.Mode}" />
                                    <Run Text=" · updated " />
                                    <Run Text="{Binding UpdatedUtc, StringFormat=yyyy-MM-dd}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
