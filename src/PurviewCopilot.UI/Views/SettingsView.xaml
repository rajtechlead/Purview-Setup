<UserControl x:Class="PurviewCopilot.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Connection" Style="{StaticResource SectionHeader}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Auth mode" Style="{StaticResource Muted}" Margin="0,8" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AuthModes}" SelectedItem="{Binding AuthMode}" Margin="0,4,16,4" />

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Tenant ID" Style="{StaticResource Muted}" Margin="0,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding TenantId}" Margin="0,4" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Application (client) ID" Style="{StaticResource Muted}" Margin="0,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ClientId}" Margin="0,4,16,4" />

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Certificate thumbprint" Style="{StaticResource Muted}" Margin="0,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Thumbprint}" Margin="0,4" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Client secret (lab only)" Style="{StaticResource Muted}" Margin="0,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4,16,4" Text="{Binding ClientSecret}"
                             ToolTip="Protected at rest with Windows DPAPI for the current user. Use certificate authentication for production." />

                    <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4">
                        <TextBlock Text="Cloud" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="130" ItemsSource="{Binding CloudEnvironments}" SelectedItem="{Binding Cloud}"
                                  Margin="0,0,10,0" ToolTip="GCC uses the commercial endpoints; GCC High and DoD use Azure Government" />
                        <Button Content="Test connection" Command="{Binding TestConnectionCommand}" Margin="0,0,8,0" />
                        <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Verify audit log integrity" Command="{Binding VerifyAuditCommand}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding AuditStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="720" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Authentication Provisioning Center" Style="{StaticResource SectionHeader}" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Creates the app registration, enterprise application and service principal, certificate or lab secret, owners, least-privilege Graph permissions and admin consent, then validates sign-in. Start with Dry run. The current connection is used as the administrator bootstrap. Operators cannot approve their own request." />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Display name" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding ProvisionDisplayName}" Margin="0,4" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Certificate lifetime" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding CertificateValidityMonths}" SelectedItem="{Binding ProvisionMonths}" Margin="0,4,16,4" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Algorithm" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding CertificateAlgorithms}" SelectedItem="{Binding ProvisionAlgorithm}" Margin="0,4" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Secret lifetime" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SecretValidityMonths}" SelectedItem="{Binding ProvisionSecretMonths}" Margin="0,4,16,4" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Environment" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="3" ItemsSource="{Binding ProvisioningEnvironments}" SelectedItem="{Binding ProvisionEnvironment}" Margin="0,4" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Owners (UPN/GUID)" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ProvisionOwners}" Margin="0,4,16,4" ToolTip="Separate multiple owners with semicolons." />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Approver / role" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal">
                        <TextBox Width="120" Text="{Binding ProvisionApprover}" Margin="0,4,6,4" />
                        <ComboBox Width="150" ItemsSource="{Binding ApproverRoles}" SelectedItem="{Binding ProvisionApproverRole}" Margin="0,4" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox Content="Dry run" IsChecked="{Binding ProvisionDryRun}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <CheckBox Content="I acknowledge a 10-year certificate" IsChecked="{Binding ProvisionAcknowledge}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button Content="Provision authentication" Style="{StaticResource PrimaryButton}" Command="{Binding ProvisionCommand}" Margin="0,0,8,0" />
                        <Button Content="Save rollback script" Command="{Binding SaveProvisionRollbackCommand}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding ProvisionStatus}" FontSize="12" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,8,0,4" />
                <TextBlock Text="{Binding ProvisionSteps}" Style="{StaticResource Muted}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,14">
                <StackPanel>
                    <TextBlock Text="Certificate lifecycle" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding CertificateWarning}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Subject" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="240" Text="{Binding CertificateSubject}" Margin="0,0,8,0" />
                        <TextBlock Text="Months" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="46" Text="{Binding CertificateMonths}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Create" Command="{Binding CreateCertificateCommand}" Margin="0,0,6,0" />
                        <Button Content="Import PFX" Command="{Binding ImportCertificateCommand}" Margin="0,0,6,0" />
                        <Button Content="Export PFX" Command="{Binding ExportCertificateCommand}" Margin="0,0,6,0" />
                        <Button Content="Rotate" Command="{Binding RotateCertificateCommand}" Margin="0,0,6,0" />
                        <Button Content="Remove" Command="{Binding RemoveCertificateCommand}" />
                    </StackPanel>

                    <TextBox Text="{Binding PfxPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                             ToolTip="Optional PFX password used for import and export" />

                    <ItemsControl ItemsSource="{Binding Certificates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Subject}" FontSize="12" />
                                        <TextBlock Style="{StaticResource Muted}">
                                            <Run Text="{Binding Thumbprint}" />
                                            <Run Text=" · expires " />
                                            <Run Text="{Binding NotAfter, StringFormat=yyyy-MM-dd}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding StorageLocation}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="AI privacy guardrail" Style="{StaticResource SectionHeader}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Mode" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Width="180" ItemsSource="{Binding RedactionModes}" SelectedItem="{Binding RedactionMode}" />
                        </StackPanel>
                        <CheckBox Content="Allow cloud AI providers" IsChecked="{Binding CloudAiEnabled}" />
                        <CheckBox Content="Offline mode (local providers only)" IsChecked="{Binding OfflineMode}" />
                        <CheckBox Content="Require administrator review before send" IsChecked="{Binding RequirePromptReview}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Azure Key Vault (optional)" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Store the app certificate PFX as a vault secret for portability and central rotation. Uses the connection credentials above and the PFX password field; the app needs Key Vault secret get/set permission." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBox Width="280" Text="{Binding KeyVaultUri}" Margin="0,0,8,0"
                                     ToolTip="https://name.vault.azure.net" />
                            <TextBox Width="220" Text="{Binding KeyVaultSecretName}"
                                     ToolTip="Secret name, e.g. purview-copilot-cert" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Upload current certificate" Command="{Binding UploadKeyVaultCommand}" Margin="0,0,8,0" />
                            <Button Content="Import from Key Vault" Command="{Binding DownloadKeyVaultCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding KeyVaultStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="AI providers" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Keys are read from environment variables named in each provider's key reference; they are never stored in the database. Order controls auto-switch: the first enabled, healthy provider is used, then the next." />
                        <ItemsControl ItemsSource="{Binding Providers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <CheckBox IsChecked="{Binding Enabled}" Content="{Binding DisplayName}" />
                                                <TextBlock Style="{StaticResource Muted}">
                                                    <Run Text="{Binding Kind}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Model}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Endpoint}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PriorityText}" Style="{StaticResource Muted}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Button Content="↑" Width="28" Padding="0" Margin="0,0,4,0"
                                                        ToolTip="Move earlier in the auto-switch sequence"
                                                        Command="{Binding DataContext.MoveProviderUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="↓" Width="28" Padding="0"
                                                        ToolTip="Move later in the auto-switch sequence"
                                                        Command="{Binding DataContext.MoveProviderDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Customer tenants (MSP mode)" Style="{StaticResource SectionHeader}" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Save the current connection as a customer tenant, then activate a tenant to point the next assessment at it. Credentials and evidence stay scoped to that tenant; switching clears the in-session assessment." />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Display name" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="240" Text="{Binding TenantDisplayName}" Margin="0,0,10,0" />
                    <Button Content="Save current connection" Command="{Binding SaveTenantCommand}" Margin="0,0,8,0" />
                    <Button Content="Activate selected" Style="{StaticResource PrimaryButton}" Command="{Binding ActivateTenantCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding TenantProfiles}" SelectedItem="{Binding SelectedTenant}" MaxHeight="180"
                         Background="{StaticResource SurfaceAltBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Muted}">
                                    <Run Text="{Binding TenantId}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding Auth.Mode}" />
                                    <Run Text=" · updated " />
                                    <Run Text="{Binding UpdatedUtc, StringFormat=yyyy-MM-dd}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Updates" Style="{StaticResource SectionHeader}" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Point at an https update manifest ({ version, downloadUrl, sha256 }). Downloads are verified against the manifest hash and saved for you to install; code signing is still recommended for enterprise rollout." />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBox Width="360" Text="{Binding UpdateManifestUrl}" Margin="0,0,8,0"
                             ToolTip="https://updates.example.com/purview/latest.json" />
                    <Button Content="Check for updates" Command="{Binding CheckUpdatesCommand}" Margin="0,0,8,0" />
                    <Button Content="Download verified MSI" Command="{Binding DownloadUpdateCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
