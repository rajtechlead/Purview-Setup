<Window x:Class="PurviewCopilot.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PurviewCopilot.UI.ViewModels"
        Title="Purview Governance Copilot"
        Height="900" Width="1440"
        MinHeight="700" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <Border Grid.Column="0" Background="#0A101C" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,18,0,12">

                <StackPanel DockPanel.Dock="Top" Margin="20,0,20,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource AccentDeepBrush}">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PURVIEW" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Governance Copilot" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Tenant" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding TenantLabel}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,2,0,8" />
                            <TextBlock Text="Overall score" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding ScoreLabel}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Margin="20,10,20,0" Style="{StaticResource Muted}"
                           Text="Assessment is read-only. Changes require a plan, simulation and approval."
                           TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding Navigation}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                               Width="26" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="28,18" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding CurrentSubtitle}" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="20" Padding="12,5" Margin="0,0,8,0">
                            <TextBlock Text="{Binding AiModeLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="20" Padding="12,5">
                            <TextBlock Text="{Binding ScoreLabel}" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,22">
                <ContentControl Content="{Binding CurrentPage}" />
            </ScrollViewer>

            <Border Grid.Row="2" Padding="28,8" Background="#0A101C" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Grid>
</Window>
